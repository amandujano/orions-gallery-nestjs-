{
  "name": "orions-gallery-nestjs",
  "version": "0.0.1",
  "description": "Orion's cat gallery — NestJS + Angular monolith for Vercel",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "vercel:build": "npm --prefix frontend install --legacy-peer-deps && npm --prefix frontend run build"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@vercel/blob": "^0.27.0",
    "@vercel/node": "^5.7.17",
    "dotenv": "^16.4.5",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
