{
  "buildCommand": "npm run vercel:build",
  "outputDirectory": "frontend/dist/orions-gallery/browser",
  "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/(.*)",       "destination": "/index.html" }
  ]
}
